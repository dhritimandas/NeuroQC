# NeuroQC — .gitignore
# Excludes large data, derived artifacts, paper sources, and anything that
# should be regenerated by running the pipeline rather than checked in.

# ── Excluded per repo policy (the codebase is what's tracked here; the data
#    + derived artifacts + paper sources + figures are NOT) ───────────────
data/
results/
derivatives/
docs/
figures/
paper/
papers/
share/
bundles/

# ── Smoke tests (run-locally checks; not part of the published pipeline) ─
scripts/smoke_full_pipeline.py
scripts/smoke_single_scan.sh

# ── Python / venv internals ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
build/
dist/
*.so

# Local virtualenv created in-place under the repo (this project uses
# ``./bin``, ``./lib``, ``./share``, ``./pyvenv.cfg``).
bin/
lib/
pyvenv.cfg
.venv/
venv/

# ── Editor / OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── DataLad / git-annex internals ───────────────────────────────────────
.datalad/
.git-annex/
.gitattributes
.lock
CACHEDIR.TAG

# ── Tool-specific transient state ───────────────────────────────────────
.claude/
*.tmp
*.bak

# ── Notebooks (not in this codebase, but defensive) ─────────────────────
.ipynb_checkpoints/

# ── Large binary inputs / outputs (defensive — should already be under data/) ─
*.nii
*.nii.gz
*.h5
*.hdf5
*.pkl
*.joblib
*.pt
*.pth
*.bin
*.onnx
